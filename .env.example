# Copy this file to .env and change every value below before deploying.
# .env is gitignored on purpose - it holds real secrets.

# ---- Postgres ----
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change_me_postgres_password

# ---- Backend API ----
JWT_SECRET=change_me_to_a_long_random_string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# ---- Redis ----
REDIS_PASSWORD=change_me_redis_password

# ---- Elasticsearch / Kibana ----
ELASTIC_PASSWORD=change_me_elastic_password
KIBANA_SYSTEM_PASSWORD=change_me_kibana_system_password

# ---- Kafka UI (basic auth) ----
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=change_me_kafka_ui_password

# ---- Domain (used for TLS cert generation / nginx server_name) ----
DOMAIN_NAME=localhost
